# ==============================================================================
# ReStockAI 2.0 — Environment Configuration Template
# ==============================================================================

# --- Environment Mode ---
# Use 'development' locally, 'production' on Render
RESTOCKAI_ENV=development

# --- Database Configuration (SQLite local default / PostgreSQL on Render) ---
# Leave unset locally to use SQLite (backend/restock.db).
# On Render, DATABASE_URL is injected automatically from Managed PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/restockai
RESTOCKAI_RUN_SEED_ON_STARTUP=true

# --- Hackathon Demo Authentication & Session Signing ---
# Set a strong demo password and cryptographic session signing secret (>= 32 chars, != demo password).
RESTOCKAI_DEMO_PASSWORD=change_me_demo_password
RESTOCKAI_SESSION_SECRET=change_me_at_least_32_random_chars
# Session TTL in minutes (1..480)
RESTOCKAI_SESSION_TTL_MINUTES=60
# Trusted proxy hops for client IP extraction (0 locally; set to 1 behind Render's single reverse proxy)
RESTOCKAI_TRUSTED_PROXY_HOPS=0
# Optional comma-separated trusted proxy CIDRs (defaults to private/loopback when HOPS > 0)
# RESTOCKAI_TRUSTED_PROXY_CIDRS=
# Failed-login rate limits (persistent DB-backed & bounded)
RESTOCKAI_LOGIN_MAX_ATTEMPTS=5
RESTOCKAI_LOGIN_GLOBAL_MAX_ATTEMPTS=25
RESTOCKAI_LOGIN_WINDOW_SECONDS=300
RESTOCKAI_MAX_RATE_LIMIT_BUCKETS=2000

# --- CORS & Frontend Origin (Production / Render) ---
# Set FRONTEND_URL to the exact HTTPS frontend origin (no wildcards) for credentialed CORS & PayPal callbacks.
# FRONTEND_URL=https://restockai-web.onrender.com
# CORS_ORIGINS=https://restockai-web.onrender.com

# --- LLM Provider Configuration ---
# Choose 'groq' for cloud inference (required on Render) or 'ollama' for local inference
RESTOCKAI_LLM_PROVIDER=groq
RESTOCKAI_GROQ_API_KEY=your_groq_api_key_here
RESTOCKAI_AGENT_MODEL=openai/gpt-oss-120b
RESTOCKAI_AGENT_TEMPERATURE=0.2

# --- Ollama Fallback Configuration (Local Dev Only) ---
RESTOCKAI_OLLAMA_HOST=http://localhost:11434

# --- PayPal Developer Sandbox Configuration ---
# Obtain Sandbox App credentials from: https://developer.paypal.com/dashboard/applications/sandbox
RESTOCKAI_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
RESTOCKAI_PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
# Optional explicit callback overrides (otherwise derived from FRONTEND_URL or localhost:5173):
# PAYPAL_RETURN_URL=https://restockai-web.onrender.com/checkout/success
# PAYPAL_CANCEL_URL=https://restockai-web.onrender.com/checkout/cancel
PAYPAL_ALLOW_MOCK=false

# --- OpenSearch Historical Index (Optional / Falls back to SQL DB) ---
# Set RESTOCKAI_OPENSEARCH_HOST only if connecting to a live OpenSearch cluster.
# RESTOCKAI_OPENSEARCH_HOST=http://localhost:9200
RESTOCKAI_OPENSEARCH_FALLBACK=true

# --- Routing Service ---
RESTOCKAI_OSRM_URL=https://router.project-osrm.org
